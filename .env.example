APP_NAME="OPES SCHOOL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Douala

APP_LOCALE=en
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opeschool
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NOTE: unquoted. phpdotenv treats a backslash inside a DOUBLE-quoted value as
# an escape sequence and aborts boot with "unexpected escape sequence" on
# Windows paths. Unquoted values are taken literally.
# Laragon (Windows) defaults below; on a Linux VPS use /usr/bin/mysqldump.
OPES_MYSQLDUMP=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe
OPES_MYSQL_CLIENT=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysql.exe
OPES_BACKUP_PATH=
# Leave empty and the health screen stays amber: a backup on the same disk as
# the database is lost with the disk. Point this at SEPARATE hardware - a USB
# drive rotated weekly is enough. Another folder on the same disk does not
# clear the warning; the check compares volumes. See docs/OPERATIONS-RUNBOOK.md.
OPES_BACKUP_SECOND_TARGET=

# One-click demo sign-in. NEVER enable on a school's live system.
OPES_DEMO_LOGIN=false

# Path to openssl.cnf. Required on Windows PHP builds for ECDSA QR signing.
OPENSSL_CONF=

# ---------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Business Cloud API)
#
# EMPTY ON PURPOSE. These are the school's OWN credentials, taken from
# developers.facebook.com -> your App -> WhatsApp -> API Setup. Nothing here
# is supplied by Opes and none of it may be guessed: with these blank the
# WhatsApp channel is inert and every send refuses loudly rather than
# pretending a parent was notified.
#
# They can also be pasted into the admin screen at /settings/whatsapp, which
# stores them in the audited settings table and takes precedence over these.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
# WhatsApp -> API Setup -> permanent System User token (whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp -> API Setup -> "Phone number ID" (the numeric id, NOT the number)
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp -> API Setup -> "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT=15
# Name of a template APPROVED in the Meta dashboard. Meta refuses free-form
# text outside the 24h service window, so school-initiated messages need this.
WHATSAPP_DEFAULT_TEMPLATE=
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en
