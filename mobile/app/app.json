{
  "expo": {
    "name": "Heritage Parent",
    "slug": "opes-guardian-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "opes",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B3B2B",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cm.opes.guardian"
    },
    "android": {
      "package": "cm.opes.guardian",
      "adaptiveIcon": {
        "backgroundColor": "#0B3B2B"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization"],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8000/api/v1"
    }
  }
}
